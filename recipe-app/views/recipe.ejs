<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= recipe.title %> - RecipeShare</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-wrapper">
                <a href="/" class="logo">🍳 RecipeShare</a>
                <ul class="nav-menu">
                    <li><a href="/">Home</a></li>
                    <li><a href="/add" class="btn-primary">+ Add Recipe</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        <div class="recipe-detail">
            <div class="recipe-header">
                <img src="<%= recipe.image %>" alt="<%= recipe.title %>" class="recipe-hero-image">
                <div class="recipe-header-info">
                    <span class="category-badge"><%= recipe.category %></span>
                    <h1><%= recipe.title %></h1>
                    <p class="author">Recipe by <%= recipe.author %></p>
                    <div class="recipe-stats">
                        <div class="stat">
                            <span class="icon">⏱️</span>
                            <div>
                                <strong>Prep Time</strong>
                                <p><%= recipe.prepTime %></p>
                            </div>
                        </div>
                        <div class="stat">
                            <span class="icon">🍳</span>
                            <div>
                                <strong>Cook Time</strong>
                                <p><%= recipe.cookTime %></p>
                            </div>
                        </div>
                        <div class="stat">
                            <span class="icon">👥</span>
                            <div>
                                <strong>Servings</strong>
                                <p><%= recipe.servings %></p>
                            </div>
                        </div>
                        <div class="stat">
                            <span class="icon">📊</span>
                            <div>
                                <strong>Difficulty</strong>
                                <p><%= recipe.difficulty %></p>
                            </div>
                        </div>
                    </div>
                    <div class="recipe-tags">
                        <% recipe.tags.forEach(tag => { %>
                            <span class="tag"><%= tag %></span>
                        <% }); %>
                    </div>
                </div>
            </div>

            <div class="recipe-body">
                <div class="ingredients-section">
                    <h2>📝 Ingredients</h2>
                    <ul class="ingredients-list">
                        <% recipe.ingredients.forEach(ingredient => { %>
                            <li><%= ingredient %></li>
                        <% }); %>
                    </ul>
                </div>

                <div class="instructions-section">
                    <h2>👨‍🍳 Instructions</h2>
                    <ol class="instructions-list">
                        <% recipe.instructions.forEach(instruction => { %>
                            <li><%= instruction %></li>
                        <% }); %>
                    </ol>
                </div>
            </div>

            <div class="recipe-actions">
                <a href="/" class="btn-secondary">← Back to Recipes</a>
                <form method="POST" action="/recipes/<%= recipe.id %>?_method=DELETE" style="display: inline;">
                    <button type="submit" class="btn-delete-large" onclick="return confirm('Are you sure you want to delete this recipe?')">
                        🗑️ Delete Recipe
                    </button>
                </form>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 RecipeShare. Made with ❤️ for food lovers.</p>
        </div>
    </footer>
</body>
</html>
