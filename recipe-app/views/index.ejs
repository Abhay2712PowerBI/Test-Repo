<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RecipeShare - Discover & Share Amazing Recipes</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-wrapper">
                <a href="/" class="logo">🍳 RecipeShare</a>
                <ul class="nav-menu">
                    <li><a href="/">Home</a></li>
                    <li><a href="/add" class="btn-primary">+ Add Recipe</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <header class="hero">
        <div class="container">
            <h1>Discover & Share Amazing Recipes</h1>
            <p>Join our community of food lovers and share your favorite dishes</p>
        </div>
    </header>

    <main class="container">
        <section class="recipes-section">
            <h2>Featured Recipes</h2>
            <div class="recipe-grid">
                <% recipes.forEach(recipe => { %>
                    <div class="recipe-card">
                        <div class="recipe-image">
                            <img src="<%= recipe.image %>" alt="<%= recipe.title %>">
                            <span class="difficulty-badge <%= recipe.difficulty.toLowerCase() %>">
                                <%= recipe.difficulty %>
                            </span>
                        </div>
                        <div class="recipe-content">
                            <h3><%= recipe.title %></h3>
                            <p class="author">By <%= recipe.author %></p>
                            <div class="recipe-meta">
                                <span>⏱️ <%= recipe.prepTime + ' + ' + recipe.cookTime %></span>
                                <span>👥 <%= recipe.servings %> servings</span>
                            </div>
                            <div class="recipe-tags">
                                <% recipe.tags.forEach(tag => { %>
                                    <span class="tag"><%= tag %></span>
                                <% }); %>
                            </div>
                            <div class="card-actions">
                                <a href="/recipes/<%= recipe.id %>" class="btn-view">View Recipe</a>
                                <form method="POST" action="/recipes/<%= recipe.id %>?_method=DELETE" style="display: inline;">
                                    <button type="submit" class="btn-delete" onclick="return confirm('Delete this recipe?')">🗑️</button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>&copy; 2025 RecipeShare. Made with ❤️ for food lovers.</p>
        </div>
    </footer>
</body>
</html>
